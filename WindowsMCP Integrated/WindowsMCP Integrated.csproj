<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>WindowsMCP_Integrated</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
    <PackageReference Include="OpenCvSharp5.Windows" Version="5.0.0.20261012" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="TesseractOCR" Version="5.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sbroenne.WindowsMcp\Sbroenne.WindowsMcp.csproj" />
    <ProjectReference Include="..\WindowsMCP Integrated.Services\WindowsMCP Integrated.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Alliance\**\*.cs;Core\**\*.cs;Game\**\*.cs;GlobalHotkeyManager.cs;ImageProcessing.cs;MouseListener.cs;TesseractService.cs;VSDuel\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Game\GameServiceFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Tesseract\" />
  </ItemGroup>

</Project>
