<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd">
<variable name="logDirectory" value="D:/Development/Last Z/Last Z Client-o-matic/WindowsMCP Integrated/logs/" />
	<targets>
		<target name="logfile" xsi:type="File" fileName="${logDirectory}/logfile.txt"
			ArchiveFileName="${logDirectory}/logfile.{####}.txt"
			archiveEvery="Run"
			ArchiveNumbering="Rolling"
		archiveOldFileOnStartup="true"
				/>
		<target name="logconsole" xsi:type="Console" />
	</targets>

	<rules>
		<logger name="*" minlevel="Debug" writeTo="logconsole" />
		<logger name="*" minlevel="Trace" writeTo="logfile" />
	</rules>
</nlog>