<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
	<RootNamespace>WindowsMCP_Integrated</RootNamespace>
	<AssemblyName>WindowsMCP_Integrated.Services</AssemblyName>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
	<PackageReference Include="OpenCvSharp5.Windows" Version="5.0.0.20261012" />
	<PackageReference Include="TesseractOCR" Version="5.5.2" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Sbroenne.WindowsMcp\Sbroenne.WindowsMcp.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Compile Include="..\WindowsMCP Integrated\**\*.cs"
			  Exclude="..\WindowsMCP Integrated\Program.cs;..\WindowsMCP Integrated\Commands\**\*.cs;..\WindowsMCP Integrated\obj\**\*.cs;..\WindowsMCP Integrated\bin\**\*.cs"
			 Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
